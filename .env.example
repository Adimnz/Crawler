# Copy to .env beside this file. Never put credentials in browser JavaScript.
CRAWLER_HOST=127.0.0.1
CRAWLER_PORT=8765
CRAWLER_WORKERS=2
# Limits for local hardware; server caps workers at 4, simultaneous requests at 32.
CRAWLER_HTTP_CONNECTIONS=8
# Time for in-flight research to finish after shutdown. Maximum: 60 seconds.
CRAWLER_SHUTDOWN_GRACE_SECONDS=15
# Required when binding to a non-loopback interface. Use HTTPS at your reverse proxy.
CRAWLER_AUTH_TOKEN=
# Personal accounts use Supabase Auth; passwords are never stored by this app.
# Set your own Supabase project URL in your local .env (never commit real configuration).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional alternative to docs/supabase-account-deletion.sql, server only:
SUPABASE_SERVICE_ROLE_KEY=
# Set the actual HTTPS address when running behind a proxy; used for email callbacks.
CRAWLER_PUBLIC_URL=
# Optional: PostgreSQL instead of the default durable SQLite database.
DATABASE_URL=
# Optional: S3-compatible object storage instead of the local content-addressed store.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# AI is enabled only when BOTH key and model are set. No browser receives these values.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Enable automatic AI translation/extraction/embeddings and bounded asset research coordination.
# Off by default to keep background API spending explicit. Research chat uses AI when configured.
CRAWLER_AUTO_AI=false
COINGECKO_API_KEY=
FRED_API_KEY=
# SEC requires an identifying application/contact User-Agent, e.g. ResearchApp contact@example.com
SEC_USER_AGENT=
# Optional C2PA validator executable. No shell is used to invoke it.
C2PA_TOOL=
